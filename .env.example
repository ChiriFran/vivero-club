# Frontend (Vite - expuestos con VITE_*)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# VITE_API_BASE_URL: solo necesario si las funciones /api viven en otro dominio.
# Dejalo vacío para usar el mismo dominio (Vercel) o con `vercel dev`.
VITE_API_BASE_URL=
VITE_FIRESTORE_COLLECTION=suscriptores

# Modo demo: true = no redirige a MercadoPago (pruebas locales sin credenciales)
VITE_MOCK_MP=false

# Backend (funciones /api: sobre todo el webhook de MercadoPago)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
MP_ACCESS_TOKEN=
MP_PREAPPROVAL_PLAN_ID=
# Clave secreta del webhook (MercadoPago → Notificaciones → clave secreta).
# Si está vacía, se omite la validación de firma (solo para desarrollo).
MP_WEBHOOK_SECRET=
# URL pública base para back_url y notification_url (ej. https://tudominio.com).
# Si está vacía, se deduce del request (recomendado setearla en producción).
MP_BACK_URL=
FIRESTORE_COLLECTION=suscriptores

# Modo demo del backend (coincide con VITE_MOCK_MP)
MOCK_MP=false

# Panel de administración (/admin) - Firebase Auth
# UID(s) de Firebase autorizados, separados por coma. Se crean en Firebase Auth.
# El panel lee/escribe Firestore directo: cargá estos mismos UID en las reglas
# de Firestore (ver README → Reglas de Firestore).
ADMIN_UIDS=
